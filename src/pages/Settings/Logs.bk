import React, { useState, useEffect } from 'react';
import apiFetch from '@wordpress/api-fetch';
import {
  Table,
  Button,
  Modal,
  Form,
  Input,
  DatePicker,
  Toast,
  Space,
  Popconfirm,
  Empty,
  Typography,
  Tag,
  Card,
  Row,
  Col,
  Spin,
} from '@douyinfe/semi-ui';
import {
  IconDelete,
  IconEdit,
  IconPlus,
  IconSearch,
  IconRefresh,
  IconDeleteStroked,
} from '@douyinfe/semi-icons';

const { Title, Text } = Typography;
const { TextArea } = Input;

// API Configuration - Update with your WordPress site URL
const API_BASE_URL = '/wp-json/plugin-starter/v1';

const Logs = () => {
    const [data, setData] = useState([]);
    const [loading, setLoading] = useState(false);
    const [total, setTotal] = useState(0);
    const [currentPage, setCurrentPage] = useState(1);
    const [pageSize, setPageSize] = useState(5);
    const [filters, setFilters] = useState({
        user_name: '',
        ip: '',
        title: '',
        created_at: '',
    });
    const [searchTerm, setSearchTerm] = useState('');
    const [isModalVisible, setIsModalVisible] = useState(false);
    const [isEditMode, setIsEditMode] = useState(false);
    const [currentLog, setCurrentLog] = useState(null);
    const [sortOrder, setSortOrder] = useState({ sortField: 'ID', order: 'descend' });

    // Fetch logs from API

    useEffect(() => {
        const fetchSettings = async () => {
            setSettingsLoading(true);
            try {
                const data = await apiFetch({
                    path: "/plugin-starter/v1/options",
                    method: 'GET'
                });
                if (data) {
                    setSettings(data);
                }
            } catch (error) {
                console.error("Error fetching settings:", error);
            } finally {
                setSettingsLoading(false);
            }
        };
        fetchSettings();
    }, [settingsReload]);
    const fetchLogs = async () => {
        setLoading(true);
        console.log(currentPage);
        console.log(pageSize);
        console.log(sortOrder);
        try {
            const params = new URLSearchParams({
                page: currentPage,
                per_page: pageSize,
                orderby: sortOrder.sortField || 'ID',
                order: sortOrder.order === 'ascend' ? 'ASC' : 'DESC',
                ...Object.fromEntries(
                    Object.entries(filters).filter(([_, v]) => v !== '')
                ),
            });

            const response = await fetch(`${API_BASE_URL}/logs?${params}`, {
                headers: {
                'X-WP-Nonce': wpApiSettings.nonce, // WordPress nonce for authentication
                },
            });

            const result = await response.json();

            if (result.success) {
                setData(result.data);
                setTotal(result.total);
            } else {
                Toast.error('Failed to fetch logs');
            }
        } catch (error) {
            Toast.error('Error fetching logs: ' + error.message);
        } finally {
            setLoading(false);
        }
    };

    // Search logs
    const searchLogs = async () => {
        if (!searchTerm) {
        fetchLogs();
        return;
        }

        setLoading(true);
        try {
        const params = new URLSearchParams({
            q: searchTerm,
            page: currentPage,
            per_page: pageSize,
        });

        const response = await fetch(`${API_BASE_URL}/logs/search?${params}`, {
            headers: {
            'X-WP-Nonce': wpApiSettings.nonce,
            },
        });

        const result = await response.json();

        if (result.success) {
            setData(result.data);
            setTotal(result.total);
        } else {
            Toast.error('Search failed');
        }
        } catch (error) {
        Toast.error('Error searching logs: ' + error.message);
        } finally {
        setLoading(false);
        }
    };

    // Create or update log
    const handleSubmit = async (values) => {
        setLoading(true);
        try {
        const url = isEditMode
            ? `${API_BASE_URL}/logs/${currentLog.ID}`
            : `${API_BASE_URL}/logs`;

        const method = isEditMode ? 'PUT' : 'POST';

        const response = await fetch(url, {
            method,
            headers: {
            'Content-Type': 'application/json',
            'X-WP-Nonce': wpApiSettings.nonce,
            },
            body: JSON.stringify(values),
        });

        const result = await response.json();

        if (result.success) {
            Toast.success(
            isEditMode ? 'Log updated successfully' : 'Log created successfully'
            );
            setIsModalVisible(false);
            fetchLogs();
        } else {
            Toast.error(result.message || 'Operation failed');
        }
        } catch (error) {
        Toast.error('Error: ' + error.message);
        } finally {
        setLoading(false);
        }
    };

    // Delete single log
    const handleDelete = async (id) => {
        setLoading(true);
        try {
        const response = await fetch(`${API_BASE_URL}/logs/${id}`, {
            method: 'DELETE',
            headers: {
            'X-WP-Nonce': wpApiSettings.nonce,
            },
        });

        const result = await response.json();

        if (result.success) {
            Toast.success('Log deleted successfully');
            fetchLogs();
        } else {
            Toast.error('Delete failed');
        }
        } catch (error) {
        Toast.error('Error deleting log: ' + error.message);
        } finally {
        setLoading(false);
        }
    };

    // Delete all logs
    const handleDeleteAll = async () => {
        setLoading(true);
        try {
        const response = await fetch(`${API_BASE_URL}/logs/delete-all`, {
            method: 'DELETE',
            headers: {
            'X-WP-Nonce': wpApiSettings.nonce,
            },
        });

        const result = await response.json();

        if (result.success) {
            Toast.success(result.message);
            fetchLogs();
        } else {
            Toast.error('Delete all failed');
        }
        } catch (error) {
        Toast.error('Error: ' + error.message);
        } finally {
        setLoading(false);
        }
    };

    // Open modal for create
    const handleCreate = () => {
        setIsEditMode(false);
        setCurrentLog(null);
        setIsModalVisible(true);
    };

    // Open modal for edit
    const handleEdit = (record) => {
        setIsEditMode(true);
        setCurrentLog(record);
        setIsModalVisible(true);
    };

    // Handle filter change
    const handleFilterChange = (field, value) => {
        setFilters((prev) => ({ ...prev, [field]: value }));
    };

    // Apply filters
    const applyFilters = () => {
        setCurrentPage(1);
        fetchLogs();
    };

    // Reset filters
    const resetFilters = () => {
        setFilters({
        user_name: '',
        ip: '',
        title: '',
        created_at: '',
        });
        setSearchTerm('');
        setCurrentPage(1);
    };

    // Table columns definition
    const columns = [
        {
        title: 'ID',
        dataIndex: 'ID',
        key: 'ID',
        width: 80,
        sorter: true,
        render: (text) => <Text strong>{text}</Text>,
        },
        {
        title: 'User',
        dataIndex: 'user_name',
        key: 'user_name',
        width: 150,
        render: (text, record) => (
            <div>
            <Text strong>{text || 'Unknown'}</Text>
            <br />
            <Text type="tertiary" size="small">
                ID: {record.user_id}
            </Text>
            </div>
        ),
        },
        {
        title: 'IP Address',
        dataIndex: 'ip',
        key: 'ip',
        width: 140,
        render: (text) => <Tag color="blue">{text}</Tag>,
        },
        {
        title: 'Title',
        dataIndex: 'title',
        key: 'title',
        width: 250,
        ellipsis: { showTitle: true },
        sorter: true,
        },
        {
        title: 'Description',
        dataIndex: 'description',
        key: 'description',
        width: 300,
        ellipsis: { showTitle: true },
        render: (text) => (
            <Text ellipsis={{ showTooltip: true }} style={{ width: 280 }}>
            {text}
            </Text>
        ),
        },
        {
        title: 'User Agent',
        dataIndex: 'user_agent',
        key: 'user_agent',
        width: 200,
        ellipsis: { showTitle: true },
        render: (text) => (
            <Text ellipsis={{ showTooltip: true }} type="tertiary" size="small">
            {text}
            </Text>
        ),
        },
        {
        title: 'Created At',
        dataIndex: 'created_at',
        key: 'created_at',
        width: 180,
        sorter: true,
        render: (text) => new Date(text).toLocaleString(),
        },
        {
        title: 'Actions',
        key: 'actions',
        width: 120,
        fixed: 'right',
        render: (_, record) => (
            <Space>
            <Button
                icon={<IconEdit />}
                type="tertiary"
                size="small"
                onClick={() => handleEdit(record)}
            />
            <Popconfirm
                title="Are you sure you want to delete this log?"
                onConfirm={() => handleDelete(record.ID)}
                okText="Yes"
                cancelText="No"
            >
                <Button
                icon={<IconDelete />}
                type="danger"
                theme="borderless"
                size="small"
                />
            </Popconfirm>
            </Space>
        ),
        },
    ];

    // Handle table change (pagination, sorting)
    // const handleTableChange = (pagination, filters, sorter) => {
    //     if (pagination) {
    //     setCurrentPage(pagination.currentPage);
    //     setPageSize(pagination.pageSize);
    //     }

    //     if (sorter && sorter.sortField) {
    //     setSortOrder({
    //         sortField: sorter.sortField,
    //         order: sorter.sortOrder,
    //     });
    //     }
    // };
    // ✅ FIXED - Proper handling of Semi Design's onChange parameters
    const handleTableChange = (pagination, filters, sorter) => {
        console.log('Table changed:', { pagination, filters, sorter });
        
        // Handle pagination properly
        if (pagination) {
            if (pagination.currentPage !== undefined && pagination.currentPage !== currentPage) {
                setCurrentPage(pagination.currentPage);
            }
            if (pagination.pageSize !== undefined && pagination.pageSize !== pageSize) {
                setPageSize(pagination.pageSize);
                setCurrentPage(1); // Reset to first page when changing page size
            }
        }

        // Handle sorting properly
        if (sorter) {
            if (sorter.sortField && sorter.sortOrder) {
                setSortOrder({
                    sortField: sorter.sortField,
                    order: sorter.sortOrder,
                });
            } else if (sorter.sortOrder === false) {
                // User cleared the sort
                setSortOrder({
                    sortField: 'ID',
                    order: 'descend',
                });
            }
        }
    };

    // Fetch logs on mount and when dependencies change
    useEffect(() => {
        if (searchTerm) {
            searchLogs();
        } else {
            fetchLogs();
        }
    }, [currentPage, pageSize, sortOrder]);

    return (
        <>
            <Card
                bodyStyle={{ padding: 0 }}
            >
                <Space>
                    <Button
                    icon={<IconRefresh />}
                    onClick={fetchLogs}
                    loading={loading}
                    >
                    Refresh
                    </Button>
                    <Button
                    icon={<IconPlus />}
                    theme="solid"
                    type="primary"
                    onClick={handleCreate}
                    >
                    Add New Log
                    </Button>
                    <Popconfirm
                    title="Are you sure you want to delete all logs?"
                    content="This action cannot be undone!"
                    onConfirm={handleDeleteAll}
                    okText="Yes, Delete All"
                    cancelText="Cancel"
                    >
                    <Button
                        icon={<IconDeleteStroked />}
                        type="danger"
                        disabled={total === 0}
                    >
                        Delete All
                    </Button>
                    </Popconfirm>
                </Space>
                {/* Filters Section */}
                <div style={{ padding: '16px 24px', background: '#fafafa' }}>
                    <Row gutter={16}>
                        <Col span={6}>
                        <Input
                            prefix={<IconSearch />}
                            placeholder="Search all fields..."
                            value={searchTerm}
                            onChange={(value) => setSearchTerm(value)}
                            onEnterPress={searchLogs}
                        />
                        </Col>
                        <Col span={4}>
                        <Input
                            placeholder="User Name"
                            value={filters.user_name}
                            onChange={(value) => handleFilterChange('user_name', value)}
                        />
                        </Col>
                        <Col span={4}>
                        <Input
                            placeholder="IP Address"
                            value={filters.ip}
                            onChange={(value) => handleFilterChange('ip', value)}
                        />
                        </Col>
                        <Col span={4}>
                        <Input
                            placeholder="Title"
                            value={filters.title}
                            onChange={(value) => handleFilterChange('title', value)}
                        />
                        </Col>
                        <Col span={4}>
                        <DatePicker
                            type="date"
                            placeholder="Created Date"
                            value={filters.created_at}
                            onChange={(date, dateString) =>
                            handleFilterChange('created_at', dateString)
                            }
                            style={{ width: '100%' }}
                        />
                        </Col>
                        <Col span={2}>
                        <Space>
                            <Button theme="solid" type="primary" onClick={applyFilters}>
                            Filter
                            </Button>
                            <Button onClick={resetFilters}>Reset</Button>
                        </Space>
                        </Col>
                    </Row>

                {/* Table */}
                <Spin spinning={loading}>
                    <Table
                        columns={columns}
                        dataSource={data}
                        rowKey="ID"
                        // pagination={{
                        //     currentPage,
                        //     pageSize,
                        //     total,
                        //     showSizeChanger: true,
                        //     pageSizeOpts: [5, 10, 20, 50, 100],
                        //     onPageChange: (page) => setCurrentPage(page),
                        //     onPageSizeChange: (size) => {
                        //         setPageSize(size);
                        //         setCurrentPage(1);
                        //     },
                        // }}
                        // ✅ NEW - Let onChange handle everything
                        pagination={{
                            currentPage,
                            pageSize,
                            total,
                            showSizeChanger: true,
                            pageSizeOpts: [5, 10, 20, 50, 100],
                            // No manual handlers - onChange handles it all
                        }}
                        onChange={handleTableChange}
                        empty={
                        <Empty
                            image={<IconSearch size="extra-large" />}
                            description="No logs found"
                        />
                        }
                        scroll={{ x: 1400 }}
                    />
                </Spin>

                </div>
            </Card>

            {/* Create/Edit Modal */}
            <Modal
                title={isEditMode ? 'Edit Log' : 'Create New Log'}
                visible={isModalVisible}
                onCancel={() => setIsModalVisible(false)}
                footer={null}
                width={600}
            >
                <Form
                initValues={
                    isEditMode && currentLog
                    ? {
                        user_id: currentLog.user_id,
                        ip: currentLog.ip,
                        user_agent: currentLog.user_agent,
                        title: currentLog.title,
                        description: currentLog.description,
                        data: currentLog.data,
                        }
                    : {}
                }
                onSubmit={handleSubmit}
                labelPosition="left"
                labelWidth="120px"
                >
                <Form.Input
                    field="user_id"
                    label="User ID"
                    placeholder="Enter user ID"
                    rules={[{ required: true, message: 'User ID is required' }]}
                    type="number"
                />
                <Form.Input
                    field="ip"
                    label="IP Address"
                    placeholder="Enter IP address"
                    rules={[{ required: true, message: 'IP address is required' }]}
                />
                <Form.Input
                    field="user_agent"
                    label="User Agent"
                    placeholder="Enter user agent"
                    rules={[{ required: true, message: 'User agent is required' }]}
                />
                <Form.Input
                    field="title"
                    label="Title"
                    placeholder="Enter title"
                    rules={[{ required: true, message: 'Title is required' }]}
                />
                <Form.TextArea
                    field="description"
                    label="Description"
                    placeholder="Enter description"
                    rows={3}
                    rules={[{ required: true, message: 'Description is required' }]}
                />
                <Form.TextArea
                    field="data"
                    label="Data (JSON)"
                    placeholder="Enter JSON data"
                    rows={4}
                    rules={[{ required: true, message: 'Data is required' }]}
                />
                <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8 }}>
                    <Button onClick={() => setIsModalVisible(false)}>Cancel</Button>
                    <Button type="primary" theme="solid" htmlType="submit">
                    {isEditMode ? 'Update' : 'Create'}
                    </Button>
                </div>
                </Form>
            </Modal>
        </>
    );
};

export default Logs;