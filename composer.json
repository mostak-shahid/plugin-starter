{
  "name": "mospress/plugin-starter",
  "description": "Plugin boilerplate for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress"
  ],
  "autoload": {
    "psr-4": {
      "MosPress\\PluginStarter\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MosPress\\PluginStarter\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Md. Mostak Shahid",
      "email": "mostak.shahid@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "wp-cli/wp-cli": "^2.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
    "wp-coding-standards/wpcs": "^3.1",
    "wp-cli/i18n-command": "^2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {},
  "scripts": {
    "makepot": "wp i18n make-pot ."
  }
}