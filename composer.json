{
  "name": "mospress/plugin-starter",
  "description": "Plugin boilerplate for WordPress",
  "type": "wordpress-plugin",
  "license": "GPLv2",
  "autoload": {
    "psr-4": {
      "MosPress\\PluginStarter\\": "php/"
    }
  },
  "authors": [
    {
      "name": "Md. Mostak Shahid",
      "email": "mostak.shahid@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "wp-cli/i18n-command": "^2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },

  "require": {},
  "scripts": {
    "makepot": "wp i18n make-pot ."
  }
}
