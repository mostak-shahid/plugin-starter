{
  "name": "plugin-starter",
  "version": "1.0.0",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "plugin-zip": "wp-scripts plugin-zip",
    "makepot": "wp i18n make-pot . languages/plugin-starter.pot --skip-js --exclude=src,vendor,node_modules --merge=languages/js.pot",
    "version": "node bin/version-replace",
    "clean-files": "node bin/clean-useless-files",
    "zip": "node bin/zip",
    "release": "npm install && npm run build && npm run clean-files && npm run version && npm run zip",
    "release:dev": "npm install && npm run build && npm run clean-files && npm run zip",
    "postinstall": "composer install"
  },
  "dependencies": {
    "@douyinfe/semi-ui": "^2.0.0",
    "@visactor/react-vchart": "^2.0.16",
    "@visactor/vchart-semi-theme": "^1.12.3",
    "@wordpress/api-fetch": "^7.39.0",
    "@wordpress/components": "^32.1.0",
    "@wordpress/i18n": "^6.12.0",
    "react": "^18.2.0",
    "react-ace": "^14.0.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",

    "@babel/preset-react": "^7.24.7",
    "@douyinfe/semi-webpack-plugin": "^2.80.0",
    "@wordpress/scripts": "^19.2.4",
    "autoprefixer": "^10.4.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "glob": "^13.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.0",
    "postcss-loader": "^8.1.1",
    "replace-in-file": "^8.4.0",
    "sass": "^1.84.0",
    "sass-loader": "^16.0.4",
    "tailwindcss": "^3.4.0"
  }
}
